{
  "name": "millimore-desktop",
  "version": "1.0.0",
  "description": "Millimore Desktop — professional live streaming for traders. Stream to Millimore, YouTube, Instagram and Facebook with automatic MT5 trade overlays.",
  "author": "Millimore",
  "license": "UNLICENSED",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "preview": "electron-vite preview",
    "lint": "eslint . --ext .js,.jsx",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "ffmpeg-static": "^5.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.4.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "vite": "^5.4.3"
  },
  "build": {
    "appId": "app.millimore.desktop",
    "productName": "Millimore Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**"
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "NSCameraUsageDescription": "Millimore Desktop uses your camera for your live stream's picture-in-picture webcam.",
        "NSMicrophoneUsageDescription": "Millimore Desktop uses your microphone for your live stream audio.",
        "NSScreenCaptureUsageDescription": "Millimore Desktop captures your screen to broadcast it on your live stream."
      }
    },
    "win": {
      "target": "nsis"
    }
  }
}
